{
  "expo": {
    "name": "UberDriver",
    "slug": "UberDriver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "UberClone Conductor usa tu ubicación para recibir solicitudes de viaje cercanas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Necesitamos acceso a tu galería para adjuntar fotos y documentos.",
          "cameraPermission": "Necesitamos la cámara para tomar tu foto, la del vehículo y tus documentos."
        }
      ],
      "expo-font",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-build-properties"
    ]
  }
}
